---
import type { Project } from "../types/Projects";

interface Props {
  project: Project;
  previousProject?: Project;
  nextProject?: Project;
}

const { project, previousProject, nextProject } = Astro.props;
const caseStudy = project.caseStudy;
const hasLinks = project.links.length > 0;
---

<main id="main-content">
  <section class="relative isolate overflow-hidden border-b border-foreground/10 bg-background px-5 pb-12 pt-8 sm:px-8 sm:pb-16 sm:pt-10 lg:px-12 lg:pb-20">
    <div aria-hidden="true" class="pointer-events-none absolute -right-36 top-8 -z-10 h-96 w-96 rounded-full bg-accent/10 blur-3xl"></div>
    <div class="mx-auto max-w-7xl">
      <a href="/#work" class="group inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
        <span aria-hidden="true" class="transition-transform group-hover:-translate-x-1">←</span>
        All projects
      </a>

      <div class="mt-9 grid gap-8 lg:grid-cols-[1fr_0.72fr] lg:items-end lg:gap-16">
        <div class="max-w-3xl">
          <div class="flex flex-wrap items-center gap-3 text-[10px] font-semibold uppercase tracking-[0.2em] text-accent sm:text-xs">
            <span>Project {project.number}</span>
            <span aria-hidden="true" class="h-1 w-1 rounded-full bg-accent/70"></span>
            <span>{project.category}</span>
            <span aria-hidden="true" class="h-1 w-1 rounded-full bg-accent/70"></span>
            <span class="text-muted">{project.year}</span>
          </div>
          <h1 class="mt-5 max-w-4xl text-5xl font-bold leading-[0.92] tracking-[-0.075em] text-foreground sm:text-6xl lg:text-8xl">
            {project.title}<span class="text-accent">.</span>
          </h1>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">{caseStudy.introduction}</p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            {hasLinks && project.links.filter((link) => link.kind === "demo" || link.kind === "repository").slice(0, 2).map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 rounded-full bg-foreground px-5 py-3 text-xs font-semibold text-background transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:text-sm">
                {link.label}<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">↗</span>
              </a>
            ))}
            <a href="/#contact" class="inline-flex items-center gap-2 rounded-full border border-foreground/15 px-5 py-3 text-xs font-semibold text-foreground transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:text-sm">
              Discuss a project
            </a>
          </div>
        </div>

        <dl class="grid grid-cols-2 gap-4 border-t border-foreground/10 pt-5 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
          <div>
            <dt class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Year</dt>
            <dd class="mt-2 text-lg font-semibold tracking-tight text-foreground">{project.year}</dd>
          </div>
          <div>
            <dt class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Focus</dt>
            <dd class="mt-2 text-sm font-semibold leading-snug text-foreground">{project.category}</dd>
          </div>
          {caseStudy.role && (
            <div class="col-span-2 mt-1 border-t border-foreground/10 pt-4">
              <dt class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Role / scope</dt>
              <dd class="mt-2 text-sm font-semibold leading-relaxed text-foreground">{caseStudy.role}</dd>
            </div>
          )}
        </dl>
      </div>

      {project.image && (
        <figure class="mt-9 overflow-hidden rounded-2xl border border-foreground/10 bg-[#171717] shadow-[0_24px_80px_-44px_rgba(0,0,0,0.35)] sm:mt-12">
          <img
            src={project.image}
            alt={project.imageAlt ?? `${project.title} project preview`}
            width={project.imageWidth ?? 1200}
            height={project.imageHeight ?? 675}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="block h-auto max-h-[620px] w-full object-contain"
          />
        </figure>
      )}
    </div>
  </section>

  <section class="bg-background px-5 py-14 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[180px_minmax(0,1fr)] lg:gap-20">
      <aside class="hidden lg:block">
        <div class="sticky top-28">
          <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-muted">On this page</p>
          <nav aria-label="Case study sections" class="mt-4 border-l border-foreground/10 pl-4">
            <a href="#overview" class="block py-2 text-xs text-muted transition-colors hover:text-accent">Overview</a>
            {project.gallery?.length ? <a href="#gallery" class="block py-2 text-xs text-muted transition-colors hover:text-accent">Gallery</a> : null}
            <a href="#approach" class="block py-2 text-xs text-muted transition-colors hover:text-accent">Approach</a>
            {caseStudy.metrics?.length ? <a href="#outcomes" class="block py-2 text-xs text-muted transition-colors hover:text-accent">Outcomes</a> : null}
            <a href="#technology" class="block py-2 text-xs text-muted transition-colors hover:text-accent">Technology</a>
          </nav>
        </div>
      </aside>

      <div class="min-w-0 max-w-4xl">
        <section id="overview" aria-labelledby="overview-title" class="scroll-mt-28">
          <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent">01 / Overview</p>
          <h2 id="overview-title" class="mt-3 text-3xl font-bold tracking-[-0.05em] text-foreground sm:text-4xl">The project.</h2>
          <p class="mt-5 max-w-3xl text-base leading-[1.9] text-muted sm:text-lg">{caseStudy.overview}</p>
        </section>

        {project.gallery && project.gallery.length > 0 && (
          <section id="gallery" aria-labelledby="gallery-title" class="mt-14 scroll-mt-28 border-t border-foreground/10 pt-10 sm:mt-16 sm:pt-12">
            <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent">Visual notes</p>
            <h2 id="gallery-title" class="mt-3 text-2xl font-bold tracking-[-0.05em] text-foreground sm:text-3xl">Inside the project.</h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              {project.gallery.map((item) => (
                <figure class="overflow-hidden rounded-xl border border-foreground/10 bg-foreground/[0.025]">
                  <img
                    src={item.src}
                    alt={item.alt}
                    width={item.width}
                    height={item.height}
                    loading="lazy"
                    decoding="async"
                    class="h-auto max-h-[440px] w-full object-contain"
                  />
                  <figcaption class="border-t border-foreground/10 px-4 py-3 text-xs leading-relaxed text-muted">{item.alt}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

        <section id="approach" aria-labelledby="approach-title" class="mt-14 scroll-mt-28 border-t border-foreground/10 pt-10 sm:mt-16 sm:pt-12">
          <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent">02 / Approach</p>
          <h2 id="approach-title" class="mt-3 text-3xl font-bold tracking-[-0.05em] text-foreground sm:text-4xl">How it is put together.</h2>
          <div class="mt-7 grid gap-3 sm:grid-cols-2">
            {caseStudy.focus.map((item, index) => (
              <article class="rounded-xl border border-foreground/10 bg-foreground/[0.025] p-5 sm:p-6">
                <span class="font-mono text-[10px] tabular-nums tracking-wider text-accent">{String(index + 1).padStart(2, "0")}</span>
                <h3 class="mt-3 text-base font-semibold tracking-tight text-foreground">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
              </article>
            ))}
          </div>
        </section>

        {caseStudy.metrics && caseStudy.metrics.length > 0 && (
          <section id="outcomes" aria-labelledby="outcomes-title" class="mt-14 scroll-mt-28 border-t border-foreground/10 pt-10 sm:mt-16 sm:pt-12">
            <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent">03 / Outcomes</p>
            <h2 id="outcomes-title" class="mt-3 text-3xl font-bold tracking-[-0.05em] text-foreground sm:text-4xl">Signals of impact.</h2>
            <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">Figures and recognition are presented as recorded in the project information; measurement details should be included where available.</p>
            <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
              {caseStudy.metrics.map((metric) => (
                <article class="rounded-xl border border-foreground/10 p-5 sm:p-6">
                  <p class="text-2xl font-bold leading-tight tracking-[-0.06em] text-foreground sm:text-3xl">{metric.value}<span class="text-accent">.</span></p>
                  <h3 class="mt-3 text-sm font-semibold leading-snug text-foreground">{metric.label}</h3>
                  {metric.detail && <p class="mt-2 text-xs leading-relaxed text-muted">{metric.detail}</p>}
                </article>
              ))}
            </div>
          </section>
        )}

        {caseStudy.outcome && (
          <section aria-labelledby="outcome-summary-title" class="mt-12 rounded-2xl border border-accent/20 bg-accent/[0.045] p-5 sm:mt-14 sm:p-7">
            <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent">Project takeaway</p>
            <h2 id="outcome-summary-title" class="mt-3 text-xl font-bold tracking-tight text-foreground">What came out of it.</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">{caseStudy.outcome}</p>
          </section>
        )}

        <section id="technology" aria-labelledby="technology-title" class="mt-14 scroll-mt-28 border-t border-foreground/10 pt-10 sm:mt-16 sm:pt-12">
          <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent">04 / Technology</p>
          <h2 id="technology-title" class="mt-3 text-3xl font-bold tracking-[-0.05em] text-foreground sm:text-4xl">Tools &amp; technologies.</h2>
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technologies used">
            {project.tags.map((tag) => (
              <li class="rounded-full border border-foreground/10 bg-foreground/[0.025] px-3 py-1.5 text-xs font-medium text-foreground/75">{tag}</li>
            ))}
          </ul>
        </section>

        {hasLinks && (
          <section aria-labelledby="resources-title" class="mt-14 border-t border-foreground/10 pt-10 sm:mt-16 sm:pt-12">
            <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent">Resources</p>
            <h2 id="resources-title" class="mt-3 text-2xl font-bold tracking-tight text-foreground">Explore the project.</h2>
            <ul class="mt-5 flex flex-wrap gap-2.5">
              {project.links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-foreground/15 px-4 py-2.5 text-xs font-semibold text-foreground transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
                    {link.label}<span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
  </section>

  <section class="border-t border-foreground/10 bg-foreground/[0.025] px-5 py-9 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent">Keep exploring</p>
          <h2 class="mt-2 text-2xl font-bold tracking-[-0.04em] text-foreground">More work, more ideas.</h2>
        </div>
        <a href="/#work" class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-foreground transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
          All projects <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {previousProject && (
          <a href={`/projects/${previousProject.slug}/`} class="group rounded-xl border border-foreground/10 bg-background p-4 transition-colors hover:border-accent/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
            <span class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">← Previous project</span>
            <span class="mt-1.5 block text-base font-semibold tracking-tight text-foreground transition-colors group-hover:text-accent">{previousProject.title}</span>
          </a>
        )}
        {nextProject && (
          <a href={`/projects/${nextProject.slug}/`} class="group rounded-xl border border-foreground/10 bg-background p-4 transition-colors hover:border-accent/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:text-right">
            <span class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Next project →</span>
            <span class="mt-1.5 block text-base font-semibold tracking-tight text-foreground transition-colors group-hover:text-accent">{nextProject.title}</span>
          </a>
        )}
      </div>

      <div class="mt-6 flex flex-col justify-between gap-3 border-t border-foreground/10 pt-5 sm:flex-row sm:items-center">
        <p class="max-w-lg text-xs leading-relaxed text-muted sm:text-sm">Have a similar challenge or want to discuss the work?</p>
        <a href="/#contact" class="inline-flex w-fit items-center gap-2 rounded-full bg-foreground px-5 py-2.5 text-xs font-semibold text-background transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
          Let's connect <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</main>
