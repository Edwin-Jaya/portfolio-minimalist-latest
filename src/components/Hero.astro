      />

      <!-- Mouse-following code trail -->
      <div
        data-code-trail
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-10 overflow-hidden"
      ></div>

      <!-- Subtle hover overlay -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-0 bg-accent/0 transition-colors duration-300 group-hover:bg-accent/10"
      ></div>

      <!-- Image caption -->
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 flex items-center justify-between bg-gradient-to-t from-black/80 to-transparent p-5 pt-16 text-white">
        <span class="text-sm font-medium tracking-wide">Edwin Jaya</span>
        <span class="text-xs text-white/70">AI × Software Engineering</span>
      </div>
    </div>

    <!-- Text: second on mobile, left on desktop -->
    <div class="relative z-10 order-2 lg:order-1">
      <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-muted sm:text-sm">
        <span class="h-2 w-2 rounded-full bg-accent"></span>
        AI & Software Engineer
      </p>

      <h1
        id="hero-title"
        class="mt-6 text-[clamp(3.5rem,8.5vw,7.8rem)] font-bold leading-[0.88] tracking-[-0.075em] text-foreground"
      >
        <span class="sr-only">Edwin Jaya — AI Engineer & Software Developer. </span>Building<br />
        <span class="text-accent">intelligent</span><br />
        systems<span class="text-accent">.</span>
      </h1>

      <p class="mt-7 max-w-lg text-base leading-relaxed text-muted sm:text-lg">
        My work spans AI research and software engineering—from NLP,
        computer vision, and RAG to full-stack applications. I'm interested
