      </div>
    </div>
  </div>
</section>

<script>
  const portrait = document.querySelector<HTMLElement>(
    "[data-code-portrait]"
  );
  const trail = portrait?.querySelector<HTMLElement>(
    "[data-code-trail]"
  );

  const snippets = [
    "const model = await predict();",
    "embedding = vectorize(text)",
    "if (score >= threshold)",
    "return response;",
    "query → retrieve → rank",
    "loss.backward()",
    "SELECT * FROM data;",
    "pipeline.execute()",
    "model.fit(dataset)",
    "import tensorflow as tf;",
    "vector.search(query)",
    "async function build()",
    "accuracy += 0.05;",
    "data.transform()",
    "await agent.run(task)",
  ];

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  let lastSpawn = 0;

  portrait?.addEventListener("pointermove", (event: PointerEvent) => {
    if (
      !trail ||
      prefersReducedMotion ||
      (event.pointerType !== "mouse" && event.pointerType !== "pen")
    ) {
      return;
    }

    const now = performance.now();

    // Limit particle creation for performance.
    if (now - lastSpawn < 55) return;
    lastSpawn = now;

    const rect = portrait.getBoundingClientRect();
    const particle = document.createElement("span");

    const snippet =
      snippets[Math.floor(Math.random() * snippets.length)];

    particle.className = "code-particle";
    particle.textContent = snippet;
    particle.style.left = `${event.clientX - rect.left}px`;
    particle.style.top = `${event.clientY - rect.top}px`;

    trail.appendChild(particle);

    const driftX = (Math.random() - 0.5) * 90;
    const driftY = -30 - Math.random() * 70;

    const animation = particle.animate(
      [
        {
          opacity: 0,
          transform: "translate(-50%, -50%) scale(0.8)",
          filter: "blur(2px)",
        },
        {
          opacity: 0.95,
          filter: "blur(0px)",
          offset: 0.15,
        },
        {
          opacity: 0,
          transform: `translate(calc(-50% + ${driftX}px), calc(-50% + ${driftY}px)) scale(1.08)`,
          filter: "blur(1px)",
        },
      ],
      {
        duration: 850,
        easing: "ease-out",
        fill: "forwards",
      }
    );

    animation.onfinish = () => particle.remove();
  });
</script>

<style>
  :global(.code-particle) {
    position: absolute;
    z-index: 10;
    max-width: 90%;
    overflow: hidden;
    color: #f7f6f2;
    font-family: monospace;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    pointer-events: none;
    text-shadow: 0 1px 8px rgb(0 0 0 / 75%);
    will-change: transform, opacity;
  }
</style>