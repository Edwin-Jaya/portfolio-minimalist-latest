      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4 border-t border-foreground/10 pt-5">
        <div>
          <p class="text-xs uppercase tracking-wider text-muted">Recognition</p>
          <p class="mt-1 text-sm font-semibold text-foreground">Global Top 100</p>
          <p class="text-xs text-muted">Google Solution Challenge</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-muted">Competition</p>
          <p class="mt-1 text-sm font-semibold text-foreground">APICTA Finalist</p>
          <p class="text-xs text-muted">2024</p>
