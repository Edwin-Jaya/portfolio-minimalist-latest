
<section
  id="home"
  aria-labelledby="hero-title"
  class="relative isolate overflow-hidden bg-background"
>
  <div class="mx-auto grid min-h-[calc(100svh-72px)] max-w-7xl grid-cols-1 items-start gap-8 px-5 pt-4 pb-12 sm:px-8 sm:pt-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-10 lg:px-12 lg:py-6">

    <!-- Portrait: first on mobile, right on desktop -->
    <div
      data-code-portrait
      class="group relative order-1 mx-auto aspect-[4/4.5] w-full max-w-[25rem] overflow-hidden rounded-[1.8rem] bg-[#171717] lg:order-2 lg:max-w-none"
    >
