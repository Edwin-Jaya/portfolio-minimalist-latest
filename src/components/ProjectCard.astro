---
interface Props {
  slug: string;
  number: string;
  title: string;
  category: string;
  year: string;
  description: string;
  tags: string[];
  outcome?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  href?: string;
  caseStudyHref?: string;
  featured?: boolean;
}

const {
  number,
  title,
  category,
  year,
  description,
  tags,
  outcome,
  image,
  imageWidth,
  imageHeight,
  imageAlt,
  href,
  caseStudyHref,
} = Astro.props;

const caseHref = caseStudyHref ?? href;
---

<article class="group flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-foreground/10 bg-background transition-[transform,border-color,box-shadow] duration-300 motion-safe:hover:-translate-y-1 hover:border-accent/40 hover:shadow-lg">
  {caseHref ? (
    <a
      href={caseHref}
      aria-label={`Read the ${title} case study`}
      class="group/preview relative block aspect-[16/9] overflow-hidden bg-[#e9e7e1] focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-accent"
    >
      {image ? (
        <img
          src={image}
          alt={imageAlt ?? `${title} project preview`}
          width={imageWidth ?? 1200}
          height={imageHeight ?? 675}
          loading="lazy"
          decoding="async"
          class="h-full w-full bg-[#111116] object-contain transition-transform duration-500 motion-safe:group-hover/preview:scale-[1.015] motion-reduce:transform-none"
        />
      ) : (
        <div aria-hidden="true" class="flex h-full items-center justify-center bg-[#171717] p-6 text-center">
          <span class="text-3xl font-bold tracking-[-0.06em] text-white/80">{title}<span class="text-accent">.</span></span>
        </div>
      )}
      <span class="absolute bottom-3 right-3 inline-flex items-center gap-2 rounded-full border border-white/20 bg-black/65 px-3 py-2 text-[10px] font-semibold text-white opacity-100 backdrop-blur-sm transition-opacity sm:opacity-0 sm:group-hover/preview:opacity-100 sm:group-focus-visible/preview:opacity-100">
        Case study <span aria-hidden="true">↗</span>
      </span>
    </a>
  ) : image ? (
    <div class="relative aspect-[16/9] overflow-hidden bg-[#e9e7e1]">
      <img src={image} alt={imageAlt ?? `${title} project preview`} width="1200" height="675" loading="lazy" decoding="async" class="h-full w-full bg-[#111116] object-contain" />
    </div>
  ) : null}

  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <div class="flex items-center justify-between gap-3">
      <span class="truncate text-[10px] font-semibold uppercase tracking-[0.16em] text-accent">{category}</span>
      <span class="shrink-0 font-mono text-[10px] tabular-nums text-muted">{year}</span>
    </div>

    <h3 class="mt-3 text-lg font-bold leading-tight tracking-[-0.04em] text-foreground sm:text-xl">
      {caseHref ? (
        <a href={caseHref} class="rounded-sm transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">{title}</a>
      ) : title}
    </h3>

    <p class="mt-2.5 line-clamp-3 flex-1 text-xs leading-relaxed text-muted sm:text-sm">{description}</p>

    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={`${title} technologies`}>
      {tags.slice(0, 4).map((tag) => (
        <li class="rounded-full border border-foreground/10 bg-foreground/[0.025] px-2.5 py-1 text-[10px] font-medium text-muted">{tag}</li>
      ))}
      {tags.length > 4 && <li class="px-1 py-1 text-[10px] text-muted">+{tags.length - 4}</li>}
    </ul>

    {outcome && (
      <p class="mt-4 line-clamp-2 border-t border-foreground/10 pt-3 text-xs leading-relaxed text-foreground/75">
        {outcome}
      </p>
    )}

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-foreground/10 pt-3">
      {caseStudyHref && (
        <a href={caseStudyHref} class="inline-flex items-center gap-1.5 text-xs font-semibold text-foreground transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
          Read case study <span aria-hidden="true">↗</span>
        </a>
      )}
      {href && (
        <a href={href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[10px] font-medium text-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
          Live project <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>
</article>
