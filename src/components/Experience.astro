---
// Mirrors the CV, except for public-page wording: "executives" (not
// "Board of Directors") and no cost-reduction percentage.
const experiences = [
  {
    organization: "PT BCA Finance",
    location: "South Jakarta, Indonesia",
    period: "Jan 2026 — Present",
    type: "Professional experience",
    roles: [
      {
        role: "IT Management Trainee (AI & Software Engineer)",
        points: [
          "Built a text-to-SQL RAG system in Python (LangChain, PandasAI, Azure OpenAI GPT-5.1, SQL Server) that lets executives query company data in natural language; currently in pilot.",
          "Built an AI document-verification pipeline for financing agreements using Azure AI Document Intelligence (OCR) and a self-hosted Gemma 4 E4B model, cutting turnaround from 15 to 5 days.",
          "Built and deployed a full-stack lending platform (Angular, Spring Boot, Kotlin/Android, SQL Server) on GCP and Firebase with CI/CD during the trainee bootcamp.",
          "Presented AI proposals to senior management; led cross-functional data verification for a large corporate event.",
        ],
      },
    ],
  },
  {
    organization: "UNIKOM CodeLabs",
    location: "Bandung, Indonesia",
    period: "Feb 2023 — Sep 2025",
    summary: "Lab Assistant, promoted from Data to ML to AI Research Team Lead",
    type: "Research & leadership",
    roles: [
      {
        role: "AI Research Lab Assistant (Team Lead)",
        period: "Jun 2024 — Sep 2025",
        points: [
          "Represented Indonesia as an Asia Pacific finalist at APICTA 2024 (Business Services; R&D) with Socialabs, as team lead, AI lead, and technical speaker.",
          "Led a team developing Socialabs, an X (Twitter) analytics platform with topic modeling, sentiment, network analysis, and influencer discovery; user research reported a 40% workflow improvement.",
          "Replaced LDA with embedded topic modeling, validated by coherence scores and human evaluation; used LLMs to generate topic labels and summaries.",
          "Built a RAG chatbot (Azure OpenAI, AI Foundry) that retrieves collected tweets per topic to answer questions with grounded responses.",
          "Automated calculations and experiment images for a faculty phase-retrieval research project with collaborators in Japan.",
          "Maintained university applications (incl. digital signature app); managed Azure and AWS resources with cost monitoring.",
        ],
      },
      {
        role: "Machine Learning Lab Assistant",
        period: "Nov 2023 — May 2024",
        points: [
          "Led ML for Doko (Google Solution Challenge 2024 Global Top 100): built a TensorFlow image classifier deployed via ONNX in Unity; across 300 students in 5 elementary schools, the share who could sort waste correctly rose from 35% to 65%.",
        ],
      },
      {
        role: "Data Lab Assistant",
        period: "Feb 2023 — Oct 2023",
        points: [
          "Delivered data workshops on analysis, visualization, and Python; researched linear regression and CNNs and presented findings in lab group discussions.",
          "Competed in COMPFEST representing CodeLabs with an ARIMA time-series forecasting model and Tableau report on Jakarta flood patterns.",
        ],
      },
    ],
  },
];

const cvHref = "https://drive.google.com/file/d/1pFDzmaPMUhqV8CxWx1YsRTXXYzsLAO0G/view?usp=sharing";
---

<section
  id="experience"
  aria-labelledby="experience-title"
  class="scroll-mt-24 border-y border-foreground/10 bg-foreground/[0.025] px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28"
>
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-6 md:grid-cols-[1fr_0.65fr] md:items-end">
      <div>
        <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-accent sm:text-sm">
          <span aria-hidden="true" class="h-2 w-2 rounded-full bg-accent"></span>
          Experience & education
        </p>
        <h2 id="experience-title" class="mt-6 text-4xl font-bold leading-[0.95] tracking-[-0.06em] text-foreground sm:text-5xl lg:text-7xl">
          Learning by<br />
          <span class="text-muted">building.</span>
        </h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-muted sm:text-base">
        From AI research at university to shipping AI systems in financial services.
      </p>
    </div>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1.25fr_0.75fr] lg:gap-20">
      <div>
        <h3 class="mb-5 text-xs font-semibold uppercase tracking-[0.18em] text-muted">Experience</h3>
        <ol class="border-l border-foreground/15">
          {experiences.map((item) => (
            <li class="relative pb-10 pl-6 last:pb-0 sm:pl-8">
              <span aria-hidden="true" class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-background bg-accent ring-1 ring-accent/30"></span>
              <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-accent">{item.type}</p>
              <div class="mt-1.5 flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-5">
                <div class="min-w-0">
                  <h4 class="text-base font-semibold leading-snug tracking-tight text-foreground sm:text-lg">{item.organization}</h4>
                  {item.summary && <p class="mt-1 text-sm italic text-foreground/75">{item.summary}</p>}
                </div>
                <div class="shrink-0 sm:text-right">
                  <time class="text-[10px] font-semibold tabular-nums text-foreground sm:text-xs">{item.period}</time>
                  <p class="text-[10px] text-muted sm:text-xs">{item.location}</p>
                </div>
              </div>

              <div class="mt-4 space-y-5">
                {item.roles.map((role) => (
                  <div>
                    {(item.roles.length > 1 || role.role) && (
                      <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-5">
                        <h5 class="text-sm font-semibold text-foreground">{role.role}</h5>
                        {role.period && <time class="shrink-0 text-[10px] font-medium tabular-nums text-muted sm:text-xs">{role.period}</time>}
                      </div>
                    )}
                    <ul class="mt-2 max-w-2xl list-disc space-y-1.5 pl-4 text-xs leading-relaxed text-muted marker:text-accent/60 sm:text-sm">
                      {role.points.map((point) => <li>{point}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
            </li>
          ))}
        </ol>
      </div>

      <aside class="h-fit rounded-2xl border border-foreground/10 bg-background p-5 sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Education</p>
        <h3 class="mt-4 text-xl font-bold tracking-tight text-foreground">Bachelor of Informatics Engineering</h3>
        <p class="mt-1 text-sm text-muted">Universitas Komputer Indonesia (UNIKOM) · Bandung</p>
        <div class="mt-5 grid grid-cols-3 gap-3 border-t border-foreground/10 pt-4">
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">Graduated</p>
            <p class="mt-1 text-sm font-semibold text-foreground">Nov 2025</p>
          </div>
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">GPA</p>
            <p class="mt-1 text-sm font-semibold text-foreground">3.83 / 4.00</p>
          </div>
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">Honors</p>
            <p class="mt-1 text-sm font-semibold text-foreground">Magna Cum Laude</p>
          </div>
        </div>
        <dl class="mt-5 space-y-4 border-t border-foreground/10 pt-4 text-sm">
          <div>
            <dt class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">Thesis</dt>
            <dd class="mt-1 leading-relaxed text-foreground/85">Embedded topic modeling with ChatGPT in Socialabs for topic context and automated summaries.</dd>
          </div>
          <div>
            <dt class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">Scholarship</dt>
            <dd class="mt-1 leading-relaxed text-foreground/85">Rector's Scholarship (75% tuition) for contributions to CodeLabs and university competitions.</dd>
          </div>
          <div>
            <dt class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">Grant</dt>
            <dd class="mt-1 leading-relaxed text-foreground/85">National PKM-KI 2024 grant (Ministry of Education) for EduClassAI, an AI-powered LMS with RAG-based Q&amp;A.</dd>
          </div>
        </dl>
        <a
          href={cvHref}
          target="_blank"
          rel="noopener noreferrer"
          class="group mt-6 inline-flex items-center gap-2 rounded-full border border-foreground/15 px-4 py-2.5 text-xs font-semibold text-foreground transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          View CV <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">↗</span>
        </a>
      </aside>
    </div>
  </div>
</section>
