---
const experiences = [
  {
    period: "2026 — Present",
    role: "Management Trainee · PDP Technology",
    organization: "BCA Finance",
    description:
      "Learning how financial-services operations, business processes, and technology systems work together.",
    type: "Professional experience",
  },
  {
    period: "Mar — Sep 2025",
    role: "AI Research Lab Assistant · Team Lead",
    organization: "CodeLabs UNIKOM",
    description:
      "Led applied AI research and product work, contributing to NLP projects, technical presentations, and knowledge sharing.",
    type: "Research & leadership",
  },
  {
    period: "May 2024 — May 2025",
    role: "Data Lab Assistant",
    organization: "CodeLabs UNIKOM",
    description:
      "Supported data science learning and research activities, helping translate analytical concepts into practical work.",
    type: "Research & education",
  },
  {
    period: "Feb 2023 — May 2024",
    role: "Machine Learning Lab Assistant",
    organization: "CodeLabs UNIKOM",
    description:
      "Supported machine-learning learning and experimentation, including applied work in AI and computer vision.",
    type: "Research & education",
  },
];
---

<section
  id="experience"
  aria-labelledby="experience-title"
  class="scroll-mt-24 border-y border-foreground/10 bg-foreground/[0.025] px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28"
>
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-6 md:grid-cols-[1fr_0.65fr] md:items-end">
      <div>
        <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-accent sm:text-sm">
          <span aria-hidden="true" class="h-2 w-2 rounded-full bg-accent"></span>
          Experience & education
        </p>
        <h2 id="experience-title" class="mt-6 text-4xl font-bold leading-[0.95] tracking-[-0.06em] text-foreground sm:text-5xl lg:text-7xl">
          Learning by<br />
          <span class="text-muted">building.</span>
        </h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-muted sm:text-base">
        A path across research, data, and financial technology—shaped by hands-on projects and continuous learning.
      </p>
    </div>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1.25fr_0.75fr] lg:gap-20">
      <div>
        <h3 class="mb-5 text-xs font-semibold uppercase tracking-[0.18em] text-muted">Experience</h3>
        <ol class="border-l border-foreground/15">
          {experiences.map((item, index) => (
            <li class="relative pb-8 pl-6 last:pb-0 sm:pl-8">
              <span aria-hidden="true" class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-background bg-accent ring-1 ring-accent/30"></span>
              <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-5">
                <div class="min-w-0">
                  <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-accent">{item.type}</p>
                  <h4 class="mt-1.5 text-base font-semibold leading-snug tracking-tight text-foreground sm:text-lg">{item.role}</h4>
                  <p class="mt-1 text-sm font-medium text-foreground/75">{item.organization}</p>
                  <p class="mt-2 max-w-2xl text-xs leading-relaxed text-muted sm:text-sm">{item.description}</p>
                </div>
                <time class="mt-1 shrink-0 text-[10px] font-medium tabular-nums text-muted sm:text-xs">{item.period}</time>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <aside class="h-fit rounded-2xl border border-foreground/10 bg-background p-5 sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Education</p>
        <h3 class="mt-4 text-xl font-bold tracking-tight text-foreground">Informatics Engineering</h3>
        <p class="mt-1 text-sm text-muted">Universitas Komputer Indonesia (UNIKOM)</p>
        <div class="mt-5 grid grid-cols-2 gap-3 border-t border-foreground/10 pt-4">
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">Academic result</p>
            <p class="mt-1 text-sm font-semibold text-foreground">Magna Cum Laude</p>
          </div>
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">GPA</p>
            <p class="mt-1 text-sm font-semibold text-foreground">3.83 / 4.00</p>
          </div>
        </div>
        <!-- <a
          href="https://drive.google.com/file/d/1nIeb3mufFINPRpMrllzj9F2uYuW641WF/view?usp=sharing"
          target="_blank"
          rel="noopener noreferrer"
          class="group mt-6 inline-flex items-center gap-2 rounded-full border border-foreground/15 px-4 py-2.5 text-xs font-semibold text-foreground transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          View CV <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">↗</span>
        </a> -->
      </aside>
    </div>
  </div>
</section>
