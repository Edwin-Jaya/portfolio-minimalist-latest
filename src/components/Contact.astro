
---
interface Props {
  email?: string;
  linkedin?: string;
  github?: string;
}

const {
  email,
  linkedin = "https://www.linkedin.com/in/edwin-jaya/",
  github,
} = Astro.props;

const year = new Date().getFullYear();
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="scroll-mt-24 overflow-hidden bg-accent px-5 py-20 text-white sm:px-8 sm:py-28 lg:px-12 lg:py-32"
>
  <div class="mx-auto max-w-7xl">
    <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-white/75 sm:text-sm">
      <span class="h-2 w-2 rounded-full bg-white"></span>
      Get in touch
    </p>

    <div class="mt-8 grid gap-10 lg:grid-cols-[1.3fr_0.7fr] lg:items-end">
      <div>
        <h2
          id="contact-title"
          class="max-w-4xl text-5xl font-bold leading-[0.9] tracking-[-0.075em] sm:text-6xl lg:text-8xl"
        >
          Let's build<br />
          something<br />
          meaningful<span class="text-white/60">.</span>
        </h2>

        <p class="mt-7 max-w-lg text-base leading-relaxed text-white/85 sm:text-lg">
          Have an idea, a technical challenge, or an opportunity
          to collaborate? Let's start a conversation about AI,
          data, and software engineering.
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          {email && (
            <a
              href={`mailto:${email}`}
              class="group inline-flex items-center gap-3 rounded-full bg-white px-6 py-4 text-sm font-semibold text-[#171717] transition-all duration-300 hover:-translate-y-1 hover:bg-[#171717] hover:text-white"
            >
              Email me
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">↗</span>
            </a>
          )}

          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 rounded-full border border-white/50 px-6 py-4 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:text-[#171717]"
          >
            Connect on LinkedIn
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">↗</span>
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-5 border-t border-white/30 pt-6 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/70">
          Find me elsewhere
        </p>

        <ul class="flex flex-col gap-4">
          <li>
            <a
              href={linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between gap-4 text-base font-medium text-white transition-colors hover:text-white/70"
            >
              LinkedIn
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">↗</span>
            </a>
          </li>

          {github && (
            <li>
              <a
                href={github}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between gap-4 text-base font-medium text-white transition-colors hover:text-white/70"
              >
                GitHub
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">↗</span>
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <!-- Footer -->
    <footer class="mt-20 flex flex-col justify-between gap-3 border-t border-white/30 pt-6 text-xs text-white/75 sm:flex-row sm:items-center">
      <p>© {year} Edwin Jaya. All rights reserved.</p>
      <a
        href="#home"
        class="group inline-flex items-center gap-2 font-medium transition-colors hover:text-white"
      >
        Back to top
        <span aria-hidden="true" class="transition-transform group-hover:-translate-y-1">↑</span>
      </a>
    </footer>
  </div>
</section>